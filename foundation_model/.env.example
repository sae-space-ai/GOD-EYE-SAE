# GOD EYE SAE Foundation Model - Environment Variables Template
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# ============================================================================
# DATA PATHS
# ============================================================================

# Root directory for datasets
# Default: foundation_model/runtime/data
# GOD_EYE_DATA_ROOT=/path/to/datasets

# Specific dataset paths (override config.yaml if set)
# TRAIN_DATASET_PATH=/path/to/train.hdf5
# VAL_DATASET_PATH=/path/to/val.hdf5
# TEST_DATASET_PATH=/path/to/test.hdf5

# ============================================================================
# WEIGHTS & BIASES (Optional)
# ============================================================================

# WandB mode: online, offline, disabled
# Default: online
# WANDB_MODE=online

# WandB project name
# Default: lidar-sar-foundation
# WANDB_PROJECT=lidar-sar-foundation

# WandB entity (username or team)
# Leave empty for default entity
# WANDB_ENTITY=

# WandB API key (if not using wandb login)
# NEVER commit this value
# WANDB_API_KEY=

# ============================================================================
# CUDA / GPU
# ============================================================================

# Visible CUDA devices
# Default: all available
# CUDA_VISIBLE_DEVICES=0,1

# CUDA memory allocation (fraction)
# Default: 1.0 (use all available)
# CUDA_MEMORY_FRACTION=0.9

# ============================================================================
# DISTRIBUTED TRAINING
# ============================================================================

# Master address for DDP
# Default: localhost
# MASTER_ADDR=localhost

# Master port for DDP
# Default: 12355
# MASTER_PORT=12355

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# LOG_LEVEL=INFO

# Log directory
# Default: foundation_model/runtime/logs
# LOG_DIR=/path/to/logs

# ============================================================================
# CHECKPOINTING
# ============================================================================

# Checkpoint directory
# Default: foundation_model/runtime/checkpoints
# CHECKPOINT_DIR=/path/to/checkpoints

# Save frequency (epochs)
# Default: 10
# CHECKPOINT_SAVE_EVERY=10

# ============================================================================
# ADVANCED
# ============================================================================

# Number of DataLoader workers
# Default: 4 (CPU), 8 (GPU)
# NUM_WORKERS=4

# Enable persistent workers
# Default: true
# PERSISTENT_WORKERS=true

# Enable pinned memory for DataLoader
# Default: true
# PIN_MEMORY=true

# Random seed
# Default: 42
# SEED=42

# Enable deterministic mode (slower but reproducible)
# Default: false
# DETERMINISTIC=false
