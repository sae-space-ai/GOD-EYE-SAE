# GOD EYE SAE — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# =============================================================================
# CLIENT-SAFE (prefixed with VITE_, exposed to browser)
# =============================================================================

# Cesium ion access token (public/restricted client token)
# Get yours at https://cesium.com/ion/
VITE_CESIUM_ION_TOKEN=

# =============================================================================
# SERVER-ONLY (never exposed to browser)
# =============================================================================

# NASA FIRMS API key (fire detection data)
# Get yours at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# AISStream API key (vessel tracking)
# Get yours at https://aisstream.io/
AISSTREAM_API_KEY=

# OpenAI API key (voice assistant)
# Get yours at https://platform.openai.com/
OPENAI_API_KEY=

# Google Maps API key (3D tiles, places)
# Get yours at https://developers.google.com/maps
GOOGLE_MAPS_API_KEY=

# TomTom API key (traffic)
# Get yours at https://developer.tomtom.com/
TOMTOM_API_KEY=

# Copernicus OAuth credentials (Sentinel satellite data)
# Register at https://identity.dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
