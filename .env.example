# SAE Intelligence Core - Environment Variables Template
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# ============================================================================
# ENVIRONMENT
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# ============================================================================
# DATABASE
# ============================================================================

# Database URL
# SQLite (development): sqlite:///./sae_core.db
# PostgreSQL (production): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./sae_core.db

# Database echo (SQL logging)
DATABASE_ECHO=false

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Secret key for JWT tokens (MUST be changed in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=change-me-in-production-use-a-real-secret

# JWT algorithm
AUTH_ALGORITHM=HS256

# Access token expiration (minutes)
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration (days)
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# API
# ============================================================================

# API host
API_HOST=0.0.0.0

# API port
API_PORT=8000

# API debug mode (MUST be false in production)
API_DEBUG=false

# CORS origins (comma-separated)
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limit (requests per minute)
API_RATE_LIMIT_PER_MINUTE=100

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Log file (optional)
# LOG_FILE=./runtime/logs/sae_core.log

# ============================================================================
# STORAGE
# ============================================================================

# Storage directories
CHECKPOINTS_DIR=./runtime/checkpoints
LOGS_DIR=./runtime/logs
OUTPUTS_DIR=./runtime/outputs
DATA_DIR=./runtime/data

# ============================================================================
# FOUNDATION MODEL
# ============================================================================

# Enable foundation model (requires PyTorch)
FOUNDATION_MODEL_ENABLED=false

# Device: cpu, cuda, mps
FOUNDATION_MODEL_DEVICE=cpu

# Precision: fp32, fp16, bf16
FOUNDATION_MODEL_PRECISION=fp32

# Checkpoint path (optional)
# FOUNDATION_MODEL_CHECKPOINT=./checkpoints/model.pt

# Batch size
FOUNDATION_MODEL_BATCH_SIZE=1

# ============================================================================
# DATA SOURCES (Optional)
# ============================================================================

# OpenSky Network credentials (optional, for higher rate limits)
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# NASA FIRMS API key (required for fire data)
# FIRMS_API_KEY=

# ============================================================================
# EXTERNAL SERVICES (Optional)
# ============================================================================

# Weights & Biases (optional)
# WANDB_API_KEY=
# WANDB_PROJECT=sae-intelligence-core
# WANDB_ENTITY=

# PostGIS (optional, for spatial queries)
# POSTGIS_URL=postgresql://user:password@host:5432/dbname

# Vector database (optional, for semantic memory)
# VECTOR_DB_URL=
# VECTOR_DB_API_KEY=
